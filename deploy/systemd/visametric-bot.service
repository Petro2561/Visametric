[Unit]
Description=Visametric Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/petro2561/Visametric
Environment=PYTHONUNBUFFERED=1
Environment=PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright
EnvironmentFile=-/home/petro2561/Visametric/.env
ExecStart=/home/petro2561/Visametric/.venv/bin/python /home/petro2561/Visametric/bot.py
Restart=always
RestartSec=10
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=visametric-bot

[Install]
WantedBy=multi-user.target
